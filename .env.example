# Supabase Configuration
VITE_SUPABASE_URL=https://your-supabase-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Admin Credentials
# IMPORTANTE: Nunca commitar credenciais reais em .env no repositório
# Use .env.local ou variáveis de ambiente no servidor
VITE_ADMIN_USERNAME=seu_usuario_admin
VITE_ADMIN_PASSWORD=sua_senha_segura
